# Token of the listener bot
DISCORD_BOT_TOKEN=

# Discord server ID
DISCORD_GUILD_ID=

# Channel where the existing attendance bot posts
ATTENDANCE_CHANNEL_ID=

# User ID of the existing attendance bot 
ATTENDANCE_BOT_ID=

# Site endpoint that will receive forwarded attendance events
PORTAL_API_URL=https://boletoportal.com/api/integrations/discord-attendance

# Secret key for authenticating with the site
PORTAL_ATTENDANCE_SECRET=

# If true, write unresolved messages to logs/unresolved.jsonl
LOG_UNRESOLVED=true

# If true, listener logs parsed payloads instead of POSTing to the portal
# Use this for a first run to confirm parsing before enabling the portal
DRY_RUN=false
